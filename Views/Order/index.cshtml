@model IEnumerable<EshopMidtrans.Models.Order>

@{
    @* Menentukan judul halaman *@
    ViewData["Title"] = "Order History";

    @* Mengambil status filter yang dipilih dari ViewData, default = All *@
    var selectedStatus = ViewData["SelectedStatus"]?.ToString() ?? "All";
}

<div class="container mt-4 mb-5">

    @* Header halaman dan tombol kembali ke halaman produk *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Riwayat Pesanan</h2>
        <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
            Kembali ke Produk
        </a>
    </div>

    @* Form untuk filter status pesanan (GET) *@
    <form method="get" asp-action="Index" class="mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-auto">
                <label for="statusFilter" class="col-form-label fw-semibold">Filter Status</label>
            </div>

            @* Dropdown untuk memilih status (All, Pending, Paid, Failed) *@
            <div class="col-auto">
                <select id="statusFilter" name="status" class="form-select" onchange="this.form.submit()">

                    @* Opsi akan otomatis terpilih berdasarkan selectedStatus *@
                    <option value="All" selected="@(selectedStatus == "All")">Semua</option>
                    <option value="Pending" selected="@(selectedStatus == "Pending")">Pending</option>
                    <option value="Paid" selected="@(selectedStatus == "Paid")">Paid</option>
                    <option value="Failed" selected="@(selectedStatus == "Failed")">Failed</option>
                </select>
            </div>
        </div>
    </form>

    @* Jika belum ada order, tampilkan pesan *@
    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center py-4 rounded shadow-sm">
            Belum ada riwayat pesanan.
        </div>
    }
    else
    {
        @* Tabel riwayat pesanan *@
        <div class="card shadow-sm rounded-3">
            <div class="card-body p-0">

                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Order ID</th>
                            <th scope="col">Total Pembayaran</th>
                            <th scope="col">Status</th>
                            <th scope="col">Tanggal</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var order in Model)
                        {
                            @* Menentukan warna badge berdasarkan status pembayaran *@
                            string badgeClass = order.PaymentStatus switch
                            {
                                "Paid" => "badge bg-success", // Hijau
                                "Pending" => "badge bg-warning text-dark", // Kuning
                                "Failed" => "badge bg-danger", // Merah
                                _ => "badge bg-secondary" // Abu-abu
                            };

                            <tr>
                                @* ID Pesanan *@
                                <td>@order.OrderId</td>

                                @* Total pembayaran format Rupiah *@
                                <td>@String.Format("Rp {0:N0}", order.Amount)</td>

                                @* Badge status (Paid / Pending / Failed) *@
                                <td>
                                    <span class="@badgeClass px-3 py-2">
                                        @order.PaymentStatus
                                    </span>
                                </td>

                                @* Tanggal dibuat dengan format dd/MM/yyyy HH:mm *@
                                <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    }
</div>